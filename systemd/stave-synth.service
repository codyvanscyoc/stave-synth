[Unit]
Description=Stave Synth — Live MIDI Synthesizer
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service
# Tolerate extended restart attempts: a transient startup failure (missing
# Faust .so after a rebuild, PipeWire not ready yet, etc.) shouldn't mark
# the unit as failed and give up mid-set. 50 attempts over 10 minutes ≈
# the time it takes the user to notice and intervene manually.
# MUST live in [Unit] — systemd ignores these keys in [Service] (which is
# where they sat, unnoticed, until Code Review #9).
StartLimitBurst=50
StartLimitIntervalSec=600

[Service]
# Type=notify: main.py sends READY=1 once the engine is up (see
# _setup_systemd_watchdog). With Type=simple the 30s watchdog armed at
# exec — a cold boot (imports + soundfont preload + JACK start) on slow
# hardware could overrun it and kill/restart-loop the service. With notify
# the watchdog only arms after READY, and startup gets normal
# start-timeout semantics instead. pw-jack execs python, so the notifying
# process IS the main PID (NotifyAccess=main works).
Type=notify
# Allow slow cold boots (SD-card Pi 4: imports + soundfont load + JACK).
TimeoutStartSec=120
# Fail truthfully if PipeWire is unavailable. The outer timeout also bounds a
# pw-cli probe that itself hangs; systemd owns any remaining child processes.
ExecStartPre=/usr/bin/timeout 5 /bin/sh -c 'until pw-cli i 0 >/dev/null 2>&1; do sleep 0.3; done'
# Do not force every USB mixer's volume to 100% during boot/recovery. Output
# selection belongs to this synth; physical interface gains are verified during
# setup, not changed globally as a startup side effect.
ExecStart=/usr/bin/pw-jack %h/stave-synth/venv/bin/python -m stave_synth.main --no-gui
WorkingDirectory=%h/stave-synth
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=STAVE_INSTANCE=stage
UnsetEnvironment=STAVE_INSTANCE_ROOT STAVE_HTTP_PORT STAVE_WEBSOCKET_PORT
# Cap glibc malloc arenas to reduce fragmentation for 24/7 operation.
# Combined with malloc_trim() in the idle GC thread, this keeps RSS stable.
Environment=MALLOC_ARENA_MAX=2
Restart=on-failure
RestartSec=5
# Watchdog: render thread updates jack.last_iter_ts every audio block;
# main.py heartbeat thread pings systemd at half this interval, but only
# if the render loop is still ticking. If audio wedges, no ping is sent
# and systemd kills + restarts us per Restart=on-failure.
WatchdogSec=30
NotifyAccess=main

[Install]
WantedBy=default.target
